# Apache .htaccess – Wonderin muistokartta-editori
Options -Indexes

# PHP-sessiot turvaan
php_value session.cookie_httponly 1
php_value session.cookie_samesite "Lax"
php_value session.use_strict_mode 1

# Suojaa konfiguraatiotiedostot
<FilesMatch "^(config\.php|\.env|.*\.sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Estä pääsy assets/-kansion PHP-tiedostoihin
<FilesMatch "\.php$">
    <If "%{REQUEST_URI} =~ m#/assets/#">
        Order Allow,Deny
        Deny from all
    </If>
</FilesMatch>

# Muistojen oletussivu → editor.php
DirectoryIndex index.php

# Turvaotsakeet
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Pakkaustuki
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Välimuisti staattiselle sisällölle
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css         "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png        "access plus 1 month"
    ExpiresByType image/webp       "access plus 1 month"
</IfModule>
