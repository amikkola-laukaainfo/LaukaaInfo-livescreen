{
    "name": "laukaainfo-web",
    "version": "1.0.0",
    "description": "LaukaaInfo Simplified Web Version",
    "scripts": {
        "start": "npx serve .",
        "dev": "npx serve .",
        "build": "node build.js",
        "seo": "node generate_seo_pages.js",
        "kohteet": "node generate_kohteet_index.js",
        "generate": "node generate_seo_pages.js && node generate_kohteet_index.js && node generate_sitemap.js",
        "build:julkaise": "npx @tailwindcss/cli -i julkaise_input.css -o julkaise.css --content julkaise.html --minify",
        "sitemap": "node generate_sitemap.js"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "serve": "^14.2.1"
    }
}
